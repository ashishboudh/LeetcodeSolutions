class Solution {
    public int maximumWealth(int[][] accounts) {
        int max = 0;

        for(int i = 0; i < accounts.length; i++){
            int eachWealth = 0;
            for(int j = 0; j < accounts[i].length; j++){
                eachWealth += accounts[i][j];
            }

            if(eachWealth > max){
                max = eachWealth;
            }
        }

        return max;
    }
}
