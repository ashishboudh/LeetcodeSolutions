class Solution {
    public int[] productExceptSelf(int[] nums) {
        int n = nums.length;
        int[] answer = new int[n];
        
        answer[n-1] = nums[n-1];
        for(int i = n-2; i >= 0; i--){
            answer[i] = answer[i+1] * nums[i];
        }

        for(int i = 1; i < n; i++){
            nums[i] = nums[i] * nums[i-1];
        }
        answer[0] = answer[1];
        for(int i = 1; i < n-1; i++){
            answer[i] = nums[i-1] * answer[i+1];
        }
        answer[n-1] = nums[n-2];
        
        return answer;
    }
}
