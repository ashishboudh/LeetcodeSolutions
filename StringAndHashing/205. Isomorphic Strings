class Solution {
    public boolean isIsomorphic(String s, String t) {
        int[] ind_s = new int[256];
        int[] ind_t = new int[256];

        for (int i = 0; i < s.length(); i++) {
            char ch_s = s.charAt(i);
            char ch_t = t.charAt(i);

            if (ind_s[ch_s] != 0 && ind_s[ch_s] != ch_t) {
                return false;
            }

            if (ind_t[ch_t] != 0 && ind_t[ch_t] != ch_s) {
                return false;
            }

            ind_s[ch_s] = ch_t;
            ind_t[ch_t] = ch_s;
        }
        return true;
    }
}
