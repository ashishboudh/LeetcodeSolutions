class Solution {
    public int reverseDegree(String s) {
        int rev_degree = 0;

        for(int i = 0; i < s.length(); i++){
            char ch = s.charAt(i);
            int reversed_alpha_val = 'z' - ch + 1;
            rev_degree += reversed_alpha_val * (i+1);
        }

        return rev_degree;
    }
}
